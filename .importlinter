[importlinter]
root_packages =
    node
    radar
    copilot
    audit
    escalation
    export
    api
    eval
    ingest
    common
    redteam
    collector

[importlinter:contract:blue-cannot-import-red]
name = Blue team must never import the red-team generator
type = forbidden
source_modules =
    node
    radar
    copilot
    audit
    escalation
    export
    api
    ingest
    common
    collector
forbidden_modules =
    redteam

[importlinter:contract:red-cannot-import-blue]
name = Red team must not import detector code
type = forbidden
source_modules =
    redteam
forbidden_modules =
    node
    radar
    copilot
    escalation
    export
    api
    eval
    collector

[importlinter:contract:node-has-no-labels-or-eval]
name = Bank-node code must not import the evaluation harness (labels live there)
type = forbidden
source_modules =
    node
    radar
forbidden_modules =
    eval

[importlinter:contract:collector-sees-no-bank-data]
name = The collector holds only masked vectors and sums: it must not import bank, radar, ingest, evaluation or red-team code
type = forbidden
source_modules =
    collector
forbidden_modules =
    node
    radar
    ingest
    copilot
    audit
    escalation
    export
    api
    eval
    redteam
